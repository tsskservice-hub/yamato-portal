{
  "name": "yamato-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build && npx esbuild server.ts --bundle --format=esm --platform=browser --external:@cloudflare/* --external:@remix-run/* --external:react --external:react-dom --outfile=functions/[[path]].js",
    "sync:knowledge": "npx tsx scripts/portal-sync-knowledge.ts",
    "deploy:full": "npm run build && npm run sync:knowledge",
    "start": "npm run build && wrangler pages dev build/client"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
    "@remix-run/dev": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "isbot": "^3.6.8",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.18",
    "tsx": "^4.23.15",
    "wrangler": "^3.114.1"
  }
}
